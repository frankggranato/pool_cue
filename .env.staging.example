# Pool Cue - Staging Environment
# For testing before production release

# ===================
# CORE SETTINGS
# ===================
FLASK_ENV=staging
FLASK_DEBUG=false
SECRET_KEY=staging-secret-key-USE-REAL-SECRET

# Server
HOST=0.0.0.0
PORT=5002

# ===================
# DATABASE
# ===================
DATABASE_URL=sqlite:///app/db/pool_queue_staging.db
# Or for PostgreSQL:
# DATABASE_URL=postgresql://user:pass@staging-db.example.com:5432/poolcue_staging

# ===================
# FEATURE FLAGS
# ===================
ENABLE_NEW_QUEUE_UI=true
ENABLE_ADS=true
ENABLE_RANKINGS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_STRIPE_PAYMENTS=false
ENABLE_QUEUE_CONFIRMATION=true

# ===================
# ACCESS CONTROL
# ===================
ALLOW_BETA_LOGIN=false

# ===================
# EXTERNAL SERVICES (staging/sandbox)
# ===================
TWILIO_ACCOUNT_SID=AC_staging_xxxxx
TWILIO_AUTH_TOKEN=staging_token
TWILIO_PHONE_NUMBER=+1234567890

STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===================
# LOGGING
# ===================
LOG_LEVEL=INFO
LOG_TO_FILE=true
