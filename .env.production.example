# Pool Cue - Production Environment
# CRITICAL: Use real secrets, stored securely!

# ===================
# CORE SETTINGS
# ===================
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=GENERATE-A-64-CHAR-RANDOM-STRING-HERE

# Server (usually reverse proxy handles this)
HOST=0.0.0.0
PORT=8000

# ===================
# DATABASE
# ===================
# Use PostgreSQL for production!
DATABASE_URL=postgresql://poolcue:PASSWORD@db.example.com:5432/poolcue_prod

# ===================
# FEATURE FLAGS
# ===================
ENABLE_NEW_QUEUE_UI=true
ENABLE_ADS=true
ENABLE_RANKINGS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_STRIPE_PAYMENTS=true
ENABLE_QUEUE_CONFIRMATION=true

# ===================
# ACCESS CONTROL
# ===================
ALLOW_BETA_LOGIN=false

# ===================
# EXTERNAL SERVICES (PRODUCTION KEYS!)
# ===================
TWILIO_ACCOUNT_SID=AC_live_xxxxx
TWILIO_AUTH_TOKEN=live_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_live_xxxxx

# ===================
# LOGGING
# ===================
LOG_LEVEL=WARNING
LOG_TO_FILE=true

# ===================
# SECURITY
# ===================
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
