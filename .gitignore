# Pool Cue - Git Ignore File
# ===========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Environment variables (NEVER commit these!)
.env
.env.local
.env.development.local
.env.staging.local
.env.production.local
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Database files (contain user data!)
*.db
*.sqlite
*.sqlite3
app/db/*.db

# Logs
*.log
logs/
app/logs/

# Flask
instance/
.webassets-cache

# Testing
.coverage
htmlcov/
.tox/
.pytest_cache/
.mypy_cache/

# Uploads and user content
app/static/uploads/
uploads/

# Ad creatives (can be large/user content)
app/static/ads/*.jpg
app/static/ads/*.png
app/static/ads/*.gif
app/static/ads/*.mp4

# Secrets and keys
*.pem
*.key
secrets/
credentials/

# Backups
*.bak
*.backup
backups/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Thumbnails
Thumbs.db

# Distribution
*.tar.gz
*.zip
*.db-shm
*.db-wal
