# Pool Cue - Development Environment
# Copy this to .env and fill in real values
# NEVER commit .env files to git!

# ===================
# CORE SETTINGS
# ===================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production

# Server
HOST=0.0.0.0
PORT=5002

# ===================
# DATABASE
# ===================
DATABASE_URL=sqlite:///app/db/pool_queue.db

# ===================
# FEATURE FLAGS
# ===================
ENABLE_NEW_QUEUE_UI=true
ENABLE_ADS=true
ENABLE_RANKINGS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_STRIPE_PAYMENTS=false
ENABLE_QUEUE_CONFIRMATION=false

# ===================
# ACCESS CONTROL
# ===================
ALLOW_BETA_LOGIN=true

# ===================
# EXTERNAL SERVICES (use test/sandbox keys)
# ===================
# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe (Payments) - use test keys!
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=

# ===================
# LOGGING
# ===================
LOG_LEVEL=DEBUG
LOG_TO_FILE=false
